<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
</head>
<body>

<header id="hdr">
  <a class="brand" href="/"><img src="/images/logo.png" alt="{{ seo.business.name }}"></a>
  <nav>
    <a class="link" href="#why-iretreat">Why iRetreat</a>
    <a class="link" href="#space">The space</a>
    <a class="link" href="#how">How it works</a>
    <a class="link" href="#quotes">Reviews</a>
    <a class="btn" href="#avail">Plan your retreat</a>
  </nav>
</header>

<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow">{{ home.hero.eyebrow }}</span>
    <h1>{{ home.hero.heading | replace(home.hero.heading_accent, "<em>" + home.hero.heading_accent + "</em>") | safe }}</h1>
    <p>{{ home.hero.intro }}</p>
    <div class="hero-cta">
      <a class="btn" href="#avail">Plan your retreat</a>
      <a class="btn outline" href="#space">See the space</a>
    </div>
    <div class="hero-stats">
      {% for s in home.hero.stats %}
      <div><span class="num">{{ s.num }}</span><span class="lbl">{{ s.label }}</span></div>
      {% endfor %}
    </div>
  </div>
  <div class="hero-img">
    <img src="{{ home.hero.image }}" alt="{{ seo.business.name }}, central Portugal" fetchpriority="high">
  </div>
</section>

<div class="strip">
  <div class="wrap">
    {% for item in home.strip %}<span>{{ item }}</span>{% endfor %}
  </div>
</div>

<section class="intro wrap" id="why-iretreat">
  <span class="eyebrow">{{ home.intro_section.eyebrow }}</span>
  <h2>{{ home.intro_section.heading | replace(home.intro_section.accent, "<em>" + home.intro_section.accent + "</em>") | safe }}</h2>
  <p class="lede">{{ home.intro_section.lede }}</p>
</section>

<section class="why wrap">
  <div class="why-head">
    <span class="eyebrow">{{ home.features_eyebrow }}</span>
    <h2>{{ home.features_heading }}</h2>
  </div>
  <div class="fgrid">
    {% for f in home.features %}
    <div class="fcard"><span class="k">{{ f.num }}</span><h3>{{ f.title }}</h3><p>{{ f.text }}</p></div>
    {% endfor %}
  </div>
</section>

<section class="biz wrap" id="biz">
  <div class="biz-head">
    <span class="eyebrow">{{ home.business.eyebrow }}</span>
    <h2>{{ home.business.heading }}</h2>
  </div>
  <div class="biz-points">
    {% for p in home.business.points %}
    <div class="biz-point"><span class="bn">{{ p.num }}</span><p>{{ p.title }}</p></div>
    {% endfor %}
  </div>
  <div class="biz-support">
    <h3>{{ home.business.support_heading }}</h3>
    <p>{{ home.business.support_text }}</p>
  </div>
</section>

<section class="space" id="space">
  <div class="wrap">
    <div class="space-head">
      <div>
        <span class="eyebrow">{{ home.space.eyebrow }}</span>
        <h2>{{ home.space.heading }}</h2>
      </div>
      <p>{{ home.space.intro }}</p>
    </div>
    <div class="bento">
      {% for g in home.space.gallery %}
      <figure><img src="{{ g.image }}" alt="{{ g.caption }}" loading="lazy" decoding="async"><figcaption>{{ g.caption }}</figcaption></figure>
      {% endfor %}
    </div>
    {% if home.space.brochure_url %}
    <div class="space-cta"><a class="btn light" href="{{ home.space.brochure_url }}" target="_blank" rel="noopener">{{ home.space.brochure_text }}</a></div>
    {% endif %}
  </div>
</section>

<section class="how wrap" id="how">
  <div class="how-head">
    <span class="eyebrow">{{ home.how_eyebrow }}</span>
    <h2>{{ home.how_heading }}</h2>
  </div>
  <div class="steps">
    {% for step in home.how %}
    <div class="step{% if loop.first %} active{% endif %}"><span class="num">{{ step.num }}</span><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div>
    {% endfor %}
  </div>
</section>

<section class="quotes" id="quotes">
  <div class="wrap">
    <span class="eyebrow">{{ home.testimonials_eyebrow }}</span>
    <h2 class="serif">{{ home.testimonials_heading }}</h2>
    <div class="qgrid">
      {% for t in home.testimonials %}
      <div class="quote"><div class="stars" aria-label="5 out of 5 stars">★★★★★</div><p>{{ t.quote }}</p><div class="who">{{ t.name }} · <span>{{ t.country }}</span></div></div>
      {% endfor %}
    </div>
    {% if home.testimonials_google_url %}
    <a class="google-reviews" href="{{ home.testimonials_google_url }}" target="_blank" rel="noopener">★★★★★ Read more reviews on Google →</a>
    {% endif %}
  </div>
</section>

<section class="avail" id="avail">
  <div class="wrap avail-grid">
    <div>
      <span class="eyebrow">{{ home.availability.eyebrow }}</span>
      <h2>{{ home.availability.heading }}</h2>
      <p class="lede">{{ home.availability.intro }}</p>
      <div class="contactline">
        <a href="mailto:{{ home.availability.email }}">{{ home.availability.email }}</a><br>
        <a href="tel:{{ home.availability.phone | replace(' ', '') }}">{{ home.availability.phone }}</a><br>
        {{ home.availability.address }}
      </div>
    </div>
    <form class="form" name="enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="enquiry">
      <p class="hp"><label>Leave this empty: <input name="bot-field"></label></p>
      <div class="row">
        <div class="field"><label>First name</label><input type="text" name="first_name" placeholder="Your name" required></div>
        <div class="field"><label>Email</label><input type="email" name="email" placeholder="you@email.com" required></div>
      </div>
      <div class="row">
        <div class="field"><label>Your social / website</label><input type="text" name="social_website" placeholder="Website or Instagram"></div>
        <div class="field"><label>Preferred dates (optional)</label><input type="text" name="preferred_dates" placeholder="e.g. May 2027"></div>
      </div>
      <div class="row">
        <div class="field"><label>Expected group size</label><input type="text" name="group_size" placeholder="Up to 16 guests"></div>
        <div class="field"><label>Have an existing client base?</label>
          <select name="existing_community">
            <option value="Yes">Yes</option>
            <option value="Currently building one">I'm currently building one</option>
            <option value="Not yet">Not yet</option>
          </select>
        </div>
      </div>
      <div class="field"><label>Tell us about your retreat (optional)</label><textarea name="retreat_details" placeholder="What are you planning? Training style, experience, anything you'd like us to know..."></textarea></div>
      <button class="btn light" type="submit">Send my enquiry</button>
    </form>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <div class="foot-brand"><img src="/images/logo.png" alt="{{ seo.business.name }}"></div>
        <p class="foot-lead">A private fitness retreat venue in central Portugal for fitness professionals who want to bring their community together.</p>
      </div>
      <div class="foot-cols">
        <div class="foot-col"><h4>Explore</h4>
          <a href="#why-iretreat">Why iRetreat</a>
          <a href="#space">The retreat space</a>
          <a href="#how">How it works</a>
          <a href="#quotes">Reviews</a>
          <a href="{{ home.space.brochure_url }}" target="_blank" rel="noopener">Retreat brochure</a>
          <a href="#avail">Plan your retreat</a>
        </div>
        <div class="foot-col"><h4>Contact</h4><a href="mailto:{{ home.availability.email }}">{{ home.availability.email }}</a><a href="tel:{{ home.availability.phone | replace(' ', '') }}">{{ home.availability.phone }}</a><p>{{ seo.business.locality }}, Portugal</p></div>
        <div class="foot-col"><h4>Follow</h4>
          {% if home.social.instagram %}<a href="{{ home.social.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
          {% if home.social.facebook %}<a href="{{ home.social.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
          {% if home.social.youtube %}<a href="{{ home.social.youtube }}" target="_blank" rel="noopener">YouTube</a>{% endif %}
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; 2026 {{ seo.business.name }}</span>
      <span class="credit">Site by <b>SPS Web &amp; Digital</b></span>
    </div>
  </div>
</footer>

{% if home.social.whatsapp %}
<a class="wa" href="https://wa.me/{{ home.social.whatsapp }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-4.9 1 1-4.8-.2-.4C5.5 18.3 5 16.7 5 15 5 8.9 9.9 4 16 4s11 4.9 11 11-4.9 9.8-11 9.8zm6-8.2c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.3-.2-.3 0-.5.1-.7.1-.1.3-.4.5-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.6s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.7 5.8 5.1.8.3 1.5.5 2 .7.8.3 1.6.2 2.2.1.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
</a>
{% endif %}

<script>
  const hdr=document.getElementById('hdr');
  const onScroll=()=>hdr.classList.toggle('scrolled',window.scrollY>60);
  onScroll();window.addEventListener('scroll',onScroll,{passive:true});
  const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.14});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  var f=document.querySelector('form[data-netlify]');
  if(f){
    f.addEventListener('submit',function(e){
      e.preventDefault();
      var body=new URLSearchParams(new FormData(f)).toString();
      fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body})
        .then(function(){f.innerHTML='<div class="form-thanks"><h3>Thank you.</h3><p>Your enquiry is on its way. We\'ll be in touch shortly.</p></div>';})
        .catch(function(){f.innerHTML='<div class="form-thanks"><h3>Something went wrong.</h3><p>Please email info@iretreat.pt directly.</p></div>';});
    });
  }
</script>
</body>
</html>
